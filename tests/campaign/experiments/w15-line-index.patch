+/* W15 experiment: index newline offsets only after a large source requires a
+ * repeated branch-sizing pass. Tokens and expression values stay ephemeral.
+ * The optimization is optional, capped at 1 MiB, and falls back on allocation
+ * failure. It never indexes deferred include buffers. */
+static const char *g_line_index_source;
+static uint32_t *g_line_index_ends;
+static size_t g_line_index_count;
+static void source_line_index_reset(void) {
+    free(g_line_index_ends); g_line_index_ends=NULL;
+    g_line_index_source=NULL; g_line_index_count=0;
+}
+static void source_line_index_prepare(const char *src) {
+    if (g_line_index_source==src) return;
+    source_line_index_reset();
+    if (!g_sym_gen || !g_branch_ord) return;
+    size_t bytes=strlen(src);
+    if (bytes<16384 || bytes>UINT32_MAX) return;
+    size_t capacity=1024,count=0;
+    uint32_t *ends=malloc(capacity*sizeof(*ends));
+    if (!ends) return;
+    const char *p=src;
+    while (*p) {
+        const char *eol=strchr(p,'\n');
+        const char *end=eol ? eol : src+bytes;
+        if (count==capacity) {
+            if (capacity>=262144) { free(ends); return; }
+            size_t next=capacity*2;
+            uint32_t *grown=realloc(ends,next*sizeof(*ends));
+            if (!grown) { free(ends); return; }
+            ends=grown; capacity=next;
+        }
+        ends[count++]=(uint32_t)(end-src);
+        if (!eol) break;
+        p=eol+1;
+    }
+    g_line_index_source=src; g_line_index_ends=ends; g_line_index_count=count;
+}
+
